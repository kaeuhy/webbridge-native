{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@webbridge-native/core": ["../core/src"],
      "@webbridge-native/cookies": ["../cookies/src"],
      "@webbridge-native/headers": ["../headers/src"],
      "@webbridge-native/mock": ["../mock/src"],
      "@webbridge-native/native-bridge": ["../native-bridge/src"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../core" },
    { "path": "../cookies" },
    { "path": "../headers" },
    { "path": "../mock" },
    { "path": "../native-bridge" }
  ]
}
